{
  "name": "zhenxuan-future-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "甄选未来员工桌面应用，使用真实系统毛玻璃窗口",
  "author": "甄选未来",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack:win": "electron-builder --win portable --x64",
    "pack:mac": "electron-builder --mac zip --universal"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "cn.xingmai.zhenxuan.desktop",
    "productName": "甄选未来",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "preload.cjs", "window-policy.cjs", "renderer/**/*", "assets/**/*", "package.json"],
    "artifactName": "ZhenxuanFuture-${version}-${os}-${arch}.${ext}",
    "win": { "target": "portable", "executableName": "ZhenxuanFuture", "icon": "assets/icon.ico" },
    "mac": { "target": "zip", "icon": "assets/icon.icns", "category": "public.app-category.business", "hardenedRuntime": true }
  }
}
