# Optional systemd drop-in. Copy to /etc/systemd/system/mengkai.service.d/mysql.conf
# then: systemctl daemon-reload && systemctl restart mengkai.service
# Secrets live in /etc/mengkai.env (mode 600), never in git.

[Service]
EnvironmentFile=-/etc/mengkai.env
StateDirectory=mengkai
Environment=MENGKAI_STATE_DIR=/var/lib/mengkai
Environment=RELEASE_MODE=shadow
