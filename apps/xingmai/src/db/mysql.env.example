# Copy to /etc/mengkai.env on the ECS (chmod 600, chown root:root).
# Do not commit a filled copy. mengkai.service should use:
#   [Service]
#   EnvironmentFile=/etc/mengkai.env
#   StateDirectory=mengkai
#
MENGKAI_STATE_DIR=/var/lib/mengkai
RELEASE_MODE=shadow
MYSQL_PORT=3306
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# CONTROLLER_WEBHOOK_SECRET=
# RELEASE_GITHUB_TOKEN=
